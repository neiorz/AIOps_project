# Virtual environments
.venv/
venv/
ENV/
env/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Local databases and Chroma vector store data
backend/data/
*.sqlite3

# Node / React
node_modules/
dist/
.vite/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Environment variables & secrets
.env
*.local

# --- Phase 0 additions (P0.10) ---
# ML model artifacts (Track T5) - large binaries, retrain instead of commit
*.joblib
*.pkl
*.onnx
*.parquet
backend/app/ml/reports/
# Runtime outputs. app/ml/data/features.csv IS committed (it is the training
# corpus); these two are regenerated on every fit / detection.
backend/app/ml/model.meta.json
backend/app/ml/data/anomalies.json

# Streamlit (Track T6)
.streamlit/secrets.toml
ui/.streamlit/secrets.toml

# Track T2 runtime database (SQLite fallback). Source, not data:
# the schema is created by `python -m app.db.init`.
backend/app/db/*.db
backend/app/db/*.db-wal
backend/app/db/*.db-shm

# Local experiment output
artifacts/
reports/

