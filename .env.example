# =============================================================================
# AIOps Platform — environment template
# Copy to `.env` (gitignored) and adjust. Every value has a working default,
# so the platform runs with no .env at all.
#   cp .env.example .env
# =============================================================================

# --- Core --------------------------------------------------------------------
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Telemetry backends ------------------------------------------------------
# In-cluster defaults (used when running inside Kubernetes):
PROMETHEUS_URL=http://prometheus-k8s.monitoring.svc.cluster.local:9090
LOKI_URL=http://loki-gateway.monitoring.svc.cluster.local:3100
TEMPO_URL=http://tempo.monitoring.svc.cluster.local:3200

# Track T1 — local docker-compose observability (host ports):
PROMETHEUS_LOCAL_URL=http://localhost:9091
LOKI_LOCAL_URL=http://localhost:3101
TEMPO_LOCAL_URL=http://localhost:3201

# --- Caching & Database (Track T2) -------------------------------------------
REDIS_URL=redis://localhost:6379/0
POSTGRES_URL=postgresql://aiops:aiops_password@localhost:5432/aiops_ground_truth

# --- Multi-tenant SLA windows (seconds) --------------------------------------
SLA_CLIENT_A_SECONDS=300
SLA_CLIENT_B_SECONDS=900
SLA_CLIENT_C_SECONDS=1800

# --- RCA safety gate ---------------------------------------------------------
# Confidence below this value blocks automated remediation.
RCA_MIN_CONFIDENCE=0.65

# --- Track T3 : Local LLM + RAG generation -----------------------------------
LLM_ENABLED=true
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=512

# --- Track T5 : Anomaly detection --------------------------------------------
# ML_MODEL_PATH must be an absolute path; it defaults to
# backend/app/ml/model.joblib, so leave it unset unless relocating the model.
# ML_MODEL_PATH=/opt/aiops/backend/app/ml/model.joblib
ML_FEATURE_WINDOW=30
ML_CONTAMINATION=0.05
ML_SCRAPE_INTERVAL_SECONDS=5

# --- Track T6 : Streamlit dashboard ------------------------------------------
STREAMLIT_PORT=8501
STREAMLIT_API_BASE=http://localhost:8000/api/v1

# --- Remediation -------------------------------------------------------------
# Override only if ansible-playbook is not on PATH and not in the venv.
# ANSIBLE_PLAYBOOK_BIN=/usr/bin/ansible-playbook
